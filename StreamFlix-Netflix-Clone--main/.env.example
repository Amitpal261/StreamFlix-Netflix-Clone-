# TMDB
VITE_TMDB_API_KEY=your_tmdb_api_key

# Firebase Web App (safe to expose in the browser; Firebase Security Rules protect data)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=optional

# Optional licensed direct media for the in-app player.
# Never put pirated/copyrighted media here.
VITE_VIDEO_URL=

# AI configuration is SERVER-SIDE only.
# Set OPENROUTER_API_KEY as a Firebase Secret; do NOT add it to VITE_*.
# Optional Firebase function parameter: OPENROUTER_MODEL=openrouter/free
